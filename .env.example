# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed (Operating Rule 6). Generate a real SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

FLASK_ENV=development
SECRET_KEY=

LOG_LEVEL=INFO
LOG_DIR=logs

# Database. DATABASE_PATH is a file path (resolved to an absolute path against the
# project root); DATABASE_URL, if set, overrides it with a full SQLAlchemy URL.
DATABASE_PATH=instance/sukoon.db
# DATABASE_URL=

# Auth tuning (ADR-0008, ADR-0017). All are config, not schema — changing them
# needs no migration.
SESSION_LIFETIME_MINUTES=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Local-only seed passwords for `flask seed` dev users. If unset, `flask seed`
# uses a loud placeholder and logs a warning — never rely on that outside dev.
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PASSWORD=
